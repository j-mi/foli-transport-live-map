# Copy to .env and adjust. No API keys are needed: Föli open data and the default basemap
# (OpenFreeMap) are both key-free.
#
# docker compose reads this file for its own variables. The backend also reads it when you run
# uvicorn on your host (from backend/), which is why DATABASE_URL points at localhost here;
# inside compose the backend gets a URL pointing at the `db` service instead.

# Database owner, used by the postgres image and by migrations.
POSTGRES_USER=transport
POSTGRES_PASSWORD=change_me
POSTGRES_DB=transport
# Least-privilege role the API connects as (created by db/init/20-app-role.sh).
APP_DB_USER=transport_app
APP_DB_PASSWORD=change_me_app
# Host port for Postgres (local development only; bound to 127.0.0.1).
DB_PORT=5432

DATABASE_URL=postgresql+asyncpg://transport_app:change_me_app@localhost:5432/transport
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://transport:change_me@localhost:5432/transport

FOLI_BASE_URL=https://data.foli.fi
# Seconds between SIRI VM polls. Föli asks for no faster than 3 s; values below are rejected.
POLL_INTERVAL_S=5
GTFS_REFRESH_HOURS=6
CORS_ORIGINS=http://localhost:5173

# Empty means the default key-free OpenFreeMap styles (light and dark).
VITE_MAP_STYLE_URL=
VITE_MAP_STYLE_URL_DARK=
